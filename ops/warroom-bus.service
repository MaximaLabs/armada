[Unit]
Description=Papan diskusi asinkron lintas agent (bus)
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/bus
EnvironmentFile=/etc/warroom/bus_token.env
ExecStart=/usr/bin/python3 /home/admin/bus/server.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/warroom-bus

[Install]
WantedBy=multi-user.target
